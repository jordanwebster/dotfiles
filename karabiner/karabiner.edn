{:layers {:symbols {:key :right_command}}
 :main   [{:des   "caps_lock to esc when pressed alone, to command as modifier"
           :rules [[:##caps_lock :left_command nil {:alone :escape}]]}
          {:des "left command to shift" 
           :rules [[:left_command :left_shift]]}
          {:des "left shift to ctrl" 
           :rules [[:left_shift :left_control]]}
          {:des "right shift to ctrl" 
           :rules [[:right_shift :right_control]]}
          {:des "backslash to hyper (cmd+ctrl+opt+shift when held, backslash when tapped)"
           :rules [[:##backslash {:key :left_shift :modi [:left_command :left_control :left_option]} nil {:alone :backslash}]]}
          {:des "symbols layer"
           :rules [:symbols 
                   [:j {:key :hyphen :modi :left_shift}] ;; _
                   [:k :equal_sign] ;; =
                   [:l {:key :comma :modi :left_shift}] ;; <
                   [:semicolon {:key :period :modi :left_shift}] ;; >
                   [:h {:key :grave_accent_and_tilde :modi :left_shift}] ;; ~
                   [:n {:key :3 :modi :left_option}] ;; #
                   [:m {:key :slash :modi :left_shift }] ;; ?
                   [:comma {:key :comma }] ;; ,
                   [:period {:key :period }] ;; .
                   [:slash {:key :slash }] ;; /
                   [:y {:key :3 :modi :left_shift}] ;; £
                   [:u {:key :1 :modi :left_shift}] ;; !
                   [:i {:key :semicolon :modi :left_shift}] ;; :
                   [:o {:key :semicolon }] ;; ;
                   [:p {:key :quote }] ;; '
                   [:a {:key :backslash :modi :left_shift}] ;; |
                   [:s {:key :7 :modi :left_shift}] ;; &
                   [:d {:key :open_bracket :modi :left_shift}] ;; {
                   [:f {:key :9 :modi :left_shift}] ;; (
                   [:g {:key :open_bracket}] ;; [
                   [:v {:key :0 :modi :left_shift}] ;; )
                   [:b {:key :close_bracket }] ;; ]
                   [:c {:key :close_bracket :modi :left_shift}] ;; }
                   [:x {:key :5 :modi :left_shift}] ;; %
                   [:z {:key :backslash}] ;; \
                   [:w {:key :hyphen}] ;; -
                   [:e {:key :equal_sign :modi :left_shift}] ;; +
                   [:r {:key :8 :modi :left_shift}] ;; *
                   [:t {:key :4 :modi :left_shift}] ;; $
]}]}
