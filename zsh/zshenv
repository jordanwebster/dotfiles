# ~/.zshenv -- read by EVERY zsh: interactive shells, scripts, and any
# subprocess a program spawns. Keep it to things that genuinely must exist
# everywhere, because everything here is inherited by everything else.

. "$HOME/.cargo/env"

# Machine-local values that are not tracked in this repo. See zsh/README.md.
#
# Anything set here is inherited by every process the shell spawns, which
# makes it a poor home for credentials: prefer the macOS keychain read on
# demand, or direnv per project. Use ~/.zshrc.local for anything only
# interactive shells need.
[ -f "$HOME/.zshenv.local" ] && . "$HOME/.zshenv.local"
